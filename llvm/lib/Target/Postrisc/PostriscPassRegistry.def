//
// This file is used as the registry of passes that are part of the AVR
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("postrisc-asm-printer-begin", PostriscAsmPrinterBeginPass())
MODULE_PASS("postrisc-asm-printer-end", PostriscAsmPrinterEndPass())
#undef MODULE_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("postrisc-asm-printer", PostriscAsmPrinterPass())
MACHINE_FUNCTION_PASS("postrisc-opt-addr-mode", PostriscOptAddrModePass())
MACHINE_FUNCTION_PASS("postrisc-frame-fixer", PostriscFrameFixerPass())
MACHINE_FUNCTION_PASS("postrisc-merge-moves", PostriscMergeMovesPass())
MACHINE_FUNCTION_PASS("postrisc-nullification", PostriscNullificationPass())
MACHINE_FUNCTION_PASS("postrisc-block-merger", PostriscBlockMergerPass())
MACHINE_FUNCTION_PASS("postrisc-bundler", PostriscBundlerPass())
MACHINE_FUNCTION_PASS("postrisc-isel", PostriscDAGToDAGISelPass(*this, getOptLevel()))
#undef MACHINE_FUNCTION_PASS
